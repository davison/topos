.env
bin/
web/node_modules/
web/.svelte-kit/

# Stray root-level node_modules (holds only a .vite/vitest cache when a
# tool is run from the repo root instead of web/) — never a real install.
/node_modules/

# The SvelteKit build output is generated by `make build` (npm run build)
# and go:embed'd by kernel/webui/embed.go — never committed. .gitkeep is
# tracked so the embed directive still resolves on a clean checkout before
# any npm build has run.
kernel/webui/build/*
!kernel/webui/build/.gitkeep

# Stray top-level binaries from a bare `go build ./...` (main packages
# compile to a binary named after their directory in the cwd when no -o is
# given) — always build via `make build` (which passes explicit -o paths)
# or scripts/e2e-smoke.sh instead.
/topos
/plugins/mock/mock
/plugins/mockstrict/mockstrict
/paperless
/topos-manifest
/topos-provenance

# Playwright e2e artifacts (traces, screenshots, html report) — never
# committed; make e2e regenerates them on every run.
web/e2e/.artifacts/

# local TODOs and notes
TODO.md

# GSD local runtime state and researcher web-fetch cache
.gsd/
.planning/research/.cache/

# Per-checkout dev config generated by `make dev-config` from the
# tracked config.dev.example.toml template — never committed, since a
# generated dev config is checkout-specific and freely hand-edited.
/config.dev.toml
